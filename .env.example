# Copy to frontend/.env.local for local development, or set these in the host's
# environment settings. Never commit real values.

# At least one provider key is required. With both set, LLM_PROVIDER picks one.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# anthropic | openai (optional; defaults to whichever key is set, Anthropic first)
LLM_PROVIDER=

# Model ids (optional). Defaults: claude-opus-5-5 for Anthropic.
EXTRACTION_MODEL=
OCR_MODEL=
# low | medium | high (optional, default low)
EXTRACTION_EFFORT=

# Safety limits (optional)
MAX_PAGES=800
RATE_LIMIT_PER_MIN=60

NODE_ENV=production
