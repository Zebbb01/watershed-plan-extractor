# Copy to frontend/.env.local for local development, or set these in the host's
# environment settings. Never commit real values.

# At least one provider key is required. With both set, LLM_PROVIDER picks one.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# anthropic | openai (optional; defaults to whichever key is set, Anthropic first)
LLM_PROVIDER=

# Model ids (optional). Defaults: claude-haiku-5-5 for Anthropic (chosen on the eval), gpt-6.1-sol for OpenAI.
EXTRACTION_MODEL=
OCR_MODEL=
# low | medium | high (optional, default low)
EXTRACTION_EFFORT=

# Safety limits (optional)
MAX_PAGES=800
RATE_LIMIT_PER_MIN=60

# Next.js sets NODE_ENV itself. On a host, set it for the runtime only: with NODE_ENV=production
# at install time, npm skips the devDependencies the build needs.
NODE_ENV=production
